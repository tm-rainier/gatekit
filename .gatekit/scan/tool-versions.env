# tool-versions.env — the scanner images gatekit runs. One place to change a version.
#
# The weekly release job (release/bump-scanners.sh) moves each pinned version to the newest
# release, runs the tests, and publishes a new gatekit version if they pass.
#
# ClamAV stays on the moving `stable` tag on purpose: its virus signatures are built into the
# image, so pinning a version would freeze the signatures.
#
# Any of these can be overridden from the environment, e.g. SCAN_IMAGE_TRIVY=aquasec/trivy:0.70.0.

SCAN_IMAGE_HADOLINT="${SCAN_IMAGE_HADOLINT:-hadolint/hadolint:v2.15.1-alpine}"
SCAN_IMAGE_CHECKOV="${SCAN_IMAGE_CHECKOV:-bridgecrew/checkov:3.4.3}"
SCAN_IMAGE_CLAMAV="${SCAN_IMAGE_CLAMAV:-clamav/clamav:stable}"
SCAN_IMAGE_GRYPE="${SCAN_IMAGE_GRYPE:-anchore/grype:v0.121.2}"
SCAN_IMAGE_TRIVY="${SCAN_IMAGE_TRIVY:-aquasec/trivy:0.76.2}"

# ClamAV publishes amd64 images only; on Apple Silicon this runs under emulation.
SCAN_PLATFORM_CLAMAV="${SCAN_PLATFORM_CLAMAV-linux/amd64}"
